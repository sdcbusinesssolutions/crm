SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_KEY
# The public URL of your application (e.g., http://localhost:3000 or https://yourdomain.com)
CLIENT_URL=http://localhost:3000

# ── Subscription / Trial Settings ────────────────────────────────────
# Number of days for the default free trial granted to every new signup.
TRIAL_DAYS=7

# Number of days after account creation within which a Tenant Admin
# is allowed to delete a trial user (no paid plan). After this window
# expires, only Super Admin can delete the user.
TENANT_ADMIN_DELETE_WINDOW_DAYS=9