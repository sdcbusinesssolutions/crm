
# Generic Solution: Central Auth Bounce
# Ideally, set VITE_MASTER_URL to your primary domain (e.g., https://clickube.com)
# This allows all sub-tenants to use this domain for auth redirects without manual whitelisting.

# Server Configuration
PORT=5000
NODE_ENV=production

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Client Configuration
CLIENT_URL=https://clickube.com
VITE_MASTER_URL=https://clickube.com

# Database
DATABASE_CONNECTION=postgresql://...

# Security
JWT_SECRET=your_jwt_secret
